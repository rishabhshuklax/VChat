# VChat configuration. Every variable here is optional — the app runs with none
# of them set. Copy to `.env` for local use, or set them in your Vercel project.

# ---------------------------------------------------------------------------
# TURN relay (strongly recommended in production)
# ---------------------------------------------------------------------------
# STUN alone connects most peers, but calls fail behind symmetric NAT and many
# corporate firewalls, where media must be relayed. A TURN server forwards only
# encrypted packets — it cannot see or decode your media.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Override the default STUN servers (comma-separated).
# STUN_URLS=stun:stun.l.google.com:19302

# ---------------------------------------------------------------------------
# Multi-instance room state
# ---------------------------------------------------------------------------
# Vercel does not guarantee that two WebSocket connections for the same room
# reach the same Function instance. Setting REDIS_URL moves the roster and the
# message fanout into Redis so rooms work across any number of instances.
# Without it, the in-memory store is used, which is correct for a single one.
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=vchat

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
# How long a signaling connection lives before the client pre-emptively
# reconnects. Keep it comfortably below the Function's maxDuration in
# vercel.json, or the platform will cut the socket first.
# WS_CONNECTION_TTL_MS=280000

# debug | info | warn | error
# LOG_LEVEL=info
